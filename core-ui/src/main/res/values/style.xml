<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="CalendarWeekday">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_columnWeight">1</item>
        <item name="android:gravity">center</item>
        <item name="android:textColor">@color/black</item>
        <item name="android:textSize">14sp</item>
        <item name="fontFamily">@font/roboto_bold</item>
        <item name="android:fontFamily">@font/roboto_bold</item>
        <item name="android:paddingVertical">4dp</item>
    </style>
    <style name="ThemeOverlay.MyApp.BottomSheetDialog" parent="ThemeOverlay.Material3.BottomSheetDialog">
        <item name="shapeAppearanceLargeComponent">@style/ShapeAppearance.Material3.LargeComponent</item>
    </style>
    <style name="BottomNavTextActive">
        <item name="android:textSize">12sp</item>
        <item name="fontFamily">@font/roboto_bold</item>
        <item name="android:fontFamily">@font/roboto_bold</item>
    </style>
    <style name="BottomNavTextInactive">
        <item name="android:textSize">12sp</item>
        <item name="fontFamily">@font/roboto_regular</item>
        <item name="android:fontFamily">@font/roboto_regular</item>
    </style>

    <style name="Widget.Material3.BottomNavigationView.ActiveIndicator.PetLink" parent="Widget.Material3.BottomNavigationView.ActiveIndicator">
        <item name="android:color">@color/transparent</item>
    </style>

    <style name="GreenDatePickerDialogTheme" parent="Theme.MaterialComponents.Light.Dialog">
        <item name="colorPrimary">@color/medium_green</item>
        <item name="colorOnPrimary">@color/icon_color</item>
        <item name="colorPrimaryVariant">@color/dark_green_variant</item>
        <item name="colorAccent">@color/medium_green</item>
    </style>

    <style name="GreenTimePickerDialogTheme" parent="ThemeOverlay.MaterialComponents.TimePicker">
        <item name="colorPrimary">@color/medium_green</item>
        <item name="colorOnPrimary">@color/icon_color</item>
        <item name="colorPrimaryVariant">@color/dark_green_variant</item>
        <item name="colorAccent">@color/medium_green</item>
        <item name="clockHandColor">@color/light_green</item>
        <item name="clockFaceBackgroundColor">@color/light_green</item>
        <item name="clockNumberTextColor">@color/black</item>
    </style>


    <style name="GreenDialogActionButton"
        parent="Widget.MaterialComponents.Button.TextButton.Dialog">
        <item name="android:textColor">@color/icon_color</item>
    </style>

    <style name="DateTextAppearance.PetLink" parent="TextAppearance.MaterialComponents.Body1">
        <item name="android:textColor">@color/black</item>
        <item name="fontFamily">@font/roboto_bold</item>
        <item name="android:fontFamily">@font/roboto_bold</item>
    </style>


    <style name="PrimaryButton.PetLink" parent="TextAppearance.AppCompat.Widget.Button">
        <item name="android:background">@drawable/bg_button_primary</item>
        <item name="fontFamily">@font/roboto_semibold</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textAlignment">center</item>
        <item name="android:padding">16dp</item>
        <item name="android:fontFamily">@font/roboto_semibold</item>
    </style>

    <style name="Widget.Material3.TextInputLayout.OutlinedBox.PetLink" parent="Widget.MaterialComponents.TextInputLayout.OutlinedBox">
        <item name="hintEnabled">false</item>
        <item name="boxCornerRadiusBottomEnd">10dp</item>
        <item name="boxCornerRadiusBottomStart">10dp</item>
        <item name="boxCornerRadiusTopEnd">10dp</item>
        <item name="boxCornerRadiusTopStart">10dp</item>
        <item name="boxStrokeWidth">0dp</item>
        <item name="boxStrokeColor">@color/transparent</item>
        <item name="boxBackgroundColor">@color/green_grey</item>
        <item name="android:textColorHint">@color/medium_green</item>
        <item name="cursorColor">@color/medium_green</item>
    </style>

    <style name="Widget.Material3.TextInputLayout.Dialog.OutlinedBox.PetLink" parent="Widget.MaterialComponents.TextInputLayout.OutlinedBox">
        <item name="hintEnabled">false</item>
        <item name="boxCornerRadiusBottomEnd">10dp</item>
        <item name="boxCornerRadiusBottomStart">10dp</item>
        <item name="boxCornerRadiusTopEnd">10dp</item>
        <item name="boxCornerRadiusTopStart">10dp</item>
        <item name="boxStrokeWidth">0dp</item>
        <item name="boxStrokeColor">@color/transparent</item>
        <item name="boxBackgroundColor">@color/medium_green_grey</item>
        <item name="android:textColorHint">@color/dark_green</item>
        <item name="cursorColor">@color/dark_green</item>
    </style>

    <style name="Widget.Material3.TextInputLayout.Dialog.OutlinedBox.Red.PetLink" parent="Widget.MaterialComponents.TextInputLayout.OutlinedBox">
        <item name="hintEnabled">false</item>
        <item name="boxCornerRadiusBottomEnd">10dp</item>
        <item name="boxCornerRadiusBottomStart">10dp</item>
        <item name="boxCornerRadiusTopEnd">10dp</item>
        <item name="boxCornerRadiusTopStart">10dp</item>
        <item name="boxStrokeWidth">0dp</item>
        <item name="boxStrokeColor">@color/transparent</item>
        <item name="boxBackgroundColor">@color/tonal_red</item>
        <item name="android:textColorHint">@color/medium_red</item>
        <item name="cursorColor">@color/red</item>
    </style>


    <style name="TabTextUnselected">
        <item name="android:textSize">16sp</item>
        <item name="fontFamily">@font/roboto_regular</item>
        <item name="android:fontFamily">@font/roboto_regular</item>
    </style>

    <style name="TabTextSelected">
        <item name="android:textSize">16sp</item>
        <item name="fontFamily">@font/roboto_medium</item>
        <item name="android:fontFamily">@font/roboto_medium</item>
    </style>

    <style name="Widget.MaterialComponents.LinearProgressIndicator.PetLink" parent="Widget.Material3.LinearProgressIndicator">
        <item name="trackCornerRadius">10dp</item>
        <item name="trackThickness">12dp</item>
        <item name="trackColor">@color/green_grey</item>
        <item name="android:max">100</item>
        <item name="indicatorColor">@color/dark_green_variant</item>
    </style>

    <style name="Widget.Material3.Button.Red.TonalButton.PetLink" parent="Widget.Material3.Button.TonalButton">
        <item name="backgroundTint">@color/tonal_red</item>
        <item name="fontFamily">@font/roboto_medium</item>
        <item name="android:fontFamily">@font/roboto_medium</item>
        <item name="android:padding">12dp</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/red</item>
    </style>

    <style name="Widget.Material3.Button.Red.TextButton.Dialog.PetLink" parent="Widget.Material3.Button.TextButton.Dialog">
        <item name="fontFamily">@font/roboto_medium</item>
        <item name="android:fontFamily">@font/roboto_medium</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/medium_red</item>
    </style>

    <style name="Widget.Material3.Button.TonalButton.PetLink" parent="Widget.Material3.Button.TonalButton">
        <item name="backgroundTint">@color/medium_green_grey</item>
        <item name="fontFamily">@font/roboto_medium</item>
        <item name="android:fontFamily">@font/roboto_medium</item>
        <item name="android:padding">12dp</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/medium_green</item>
    </style>

    <style name="Widget.Material3.Button.TextButton.Dialog.PetLink" parent="Widget.Material3.Button.TextButton.Dialog">
        <item name="fontFamily">@font/roboto_medium</item>
        <item name="android:fontFamily">@font/roboto_medium</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/medium_green</item>
    </style>

    <style name="PrimaryButton.Variant.PetLink" parent="TextAppearance.AppCompat.Widget.Button">
        <item name="android:background">@drawable/bg_button_primary_variant</item>
        <item name="fontFamily">@font/roboto_semibold</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">@color/dark_green_variant</item>
        <item name="android:textAlignment">center</item>
        <item name="android:padding">16dp</item>
        <item name="android:fontFamily">@font/roboto_semibold</item>
    </style>
</resources>