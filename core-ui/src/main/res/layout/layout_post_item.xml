<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingHorizontal="20dp"
    android:paddingTop="16dp"
    android:paddingBottom="8dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <petlink.android.core_ui.custom_view.round_avatar.ShapeableImageView
            android:id="@+id/community_avatar"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_round_image"
            android:clipToOutline="true"
            tools:src="@tools:sample/avatars" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/community_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/roboto_bold"
                android:textColor="@color/black"
                android:textSize="14sp"
                tools:text="Мир Кошек" />

            <TextView
                android:id="@+id/community_type"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:fontFamily="@font/roboto_regular"
                android:textColor="@color/subtitle_green_grey"
                android:textSize="12sp"
                tools:text="Новостное сообщество" />
        </LinearLayout>

        <ImageView
            android:id="@+id/edit_icon"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:background="@drawable/ripple_round"
            android:clickable="true"
            android:focusable="true"
            android:padding="2dp"
            android:src="@drawable/ic_edit"
            android:visibility="gone"
            tools:visibility="visible" />
    </LinearLayout>

    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/photos_pager"
        android:layout_width="match_parent"
        android:layout_height="206dp"
        android:layout_marginTop="12dp"
        android:clipToPadding="false"
        android:visibility="gone" />

    <petlink.android.core_ui.custom_view.post_view.PostView
        android:id="@+id/post"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp" />

</LinearLayout>
